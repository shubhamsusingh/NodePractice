<%- include('../includes/head.ejs') %>
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
        <% if (orders.length <= 0) {%>
        <main>
            <h1>Nothing there!</h1>
        </main>
        <%} else {%>
            <ul>
                <% orders.forEach(order=>{%>
                <li>
                    <h1># <%= order.id %></h1>
                    <ul>
                        <%order.products.forEach(products=>{%>
                            <li><%= products.title %>(<%= products.orderItem.quantity %>)<a href="/orders/<%=order.id%>">invoices</a></li>
                        <%});%>
                    </ul>
                </li>
                <% });%>
            </ul>
          <% } %>  
        <%- include('../includes/end.ejs') %>